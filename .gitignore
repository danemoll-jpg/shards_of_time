# Unity
Library/
Temp/
Obj/
Logs/
UserSettings/
Build/
Builds/
# Builds/PublisherPrivate/ holds the launcher signing key: never commit it (covered by Builds/ above, listed for clarity)
Builds/PublisherPrivate/
*.csproj
*.sln
*.slnx
.vs/
__pycache__/
# Unity crash-recovery scenes
Assets/_Recovery/
Assets/_Recovery.meta
# Per-machine check output and scratch
local/
# Unity Recorder output (cutscene renders; big, made again from the Timeline)
Recordings/
# Meshy raw FBX duplicates the GLB; Blender backups
SourceArt/Meshy/*/model.fbx
SourceArt/Meshy/*/*.blend
*.blend1
# Suno soundtrack ships through the launcher soundtrack component, not git
BundleMusic/

# Round 2: rejected / regenerable art (kept on disk, not in git): the first abi_home (hair joined to the sweater), the zipped
# OBJ backups of the Mixamo uploads, Kira's rig .blend (Tools/Blender/kira_rig.py remakes it)
SourceArt/Meshy/*_v1/
SourceArt/Mixamo/*/v1/
SourceArt/Mixamo/*/upload/*_obj.zip
SourceArt/Rigged/*/*.blend
SourceArt/Rigged/*/*.blend1
